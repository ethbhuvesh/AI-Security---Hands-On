# Copy to `.env` and fill in. `.env` is gitignored -- never commit real keys.

# --- Gemini (Google AI Studio) ---------------------------------------------
GEMINI_API_KEY=paste-your-aistudio-key-here
GEMINI_MODEL=gemini-3.5-flash
# A cheaper/faster model used only for security classification calls.
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite

# --- Embeddings -------------------------------------------------------------
# Local model. It is downloaded once, then scanned, hashed and signed.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_DIR=models/all-MiniLM-L6-v2
# Set to false ONLY while you are first downloading the model.
ENFORCE_MODEL_SIGNATURE=true

# --- Vector store -----------------------------------------------------------
CHROMA_DIR=data/chroma
COLLECTION_NAME=kb

# --- Guardrail policy -------------------------------------------------------
INJECTION_BLOCK_THRESHOLD=0.75
INJECTION_FLAG_THRESHOLD=0.45
ENABLE_LLM_JUDGE=true
# Human-in-the-loop confirmation before any state-changing MCP tool runs.
REQUIRE_HUMAN_APPROVAL=true
# Domains the model is allowed to emit links to (data-exfiltration defence).
ALLOWED_LINK_DOMAINS=example.com,docs.python.org

# --- Ops --------------------------------------------------------------------
AUDIT_LOG_PATH=data/audit.log
MAX_TOOL_CALLS_PER_REQUEST=4
